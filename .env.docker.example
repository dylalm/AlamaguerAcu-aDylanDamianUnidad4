# Variables del entorno Docker (copia este archivo a .env.docker y completa los valores)
# Se usa con:  docker compose --env-file .env.docker up -d --build

APP_KEY=base64:GENERALA_CON_php_artisan_key:generate_--show
APP_URL=https://manovecina.test

DB_DATABASE=manovecina
DB_USERNAME=manovecina
DB_PASSWORD=cambia-esta-clave
DB_ROOT_PASSWORD=cambia-esta-clave-de-root

# true = carga las herramientas de ejemplo al iniciar
SEED_DEMO=true
